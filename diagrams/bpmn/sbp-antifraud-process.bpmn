<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SBP_Antifraud" targetNamespace="http://bpmn.io/schema/bpmn" exporter="hand-written generator" exporterVersion="1.0">
<bpmn:error id="Error_ModelUnavailable" name="Модель недоступна" errorCode="MODEL_UNAVAILABLE" />
<bpmn:collaboration id="Collab_SBP_Antifraud">
<bpmn:documentation>Т-Банк: антифрод-решение по исходящему переводу СБП</bpmn:documentation>
<bpmn:participant id="Pool_NSPK" name="НСПК (операционный центр СБП)" />
<bpmn:participant id="Pool_Client" name="Клиент-отправитель (мобильное приложение)" processRef="Process_Client" />
<bpmn:participant id="Pool_Bank" name="Т-Банк" processRef="Process_Bank" />
<bpmn:messageFlow id="MF_Submit" name="заявка на перевод" sourceRef="C_Submit" targetRef="P_Start" />
<bpmn:messageFlow id="MF_Warn" name="предупреждение" sourceRef="D_Warn" targetRef="C_Warn" />
<bpmn:messageFlow id="MF_Decide" name="подтвердил / отменил" sourceRef="C_Decide" targetRef="D_WaitAnswer" />
<bpmn:messageFlow id="MF_Call" name="звонок" sourceRef="A_Call" targetRef="C_Call" />
<bpmn:messageFlow id="MF_Answer" name="ответы клиента" sourceRef="C_Answer" targetRef="A_Call" />
<bpmn:messageFlow id="MF_ResOk" name="итог: выполнен" sourceRef="P_Complete" targetRef="C_Result" />
<bpmn:messageFlow id="MF_ResDecl" name="итог: отклонён" sourceRef="P_Decline" targetRef="C_Result" />
<bpmn:messageFlow id="MF_ToNSPK" name="платёж" sourceRef="P_SendNSPK" targetRef="Pool_NSPK" />
<bpmn:messageFlow id="MF_FromNSPK" name="подтверждение" sourceRef="Pool_NSPK" targetRef="P_SendNSPK" />
</bpmn:collaboration>
<bpmn:process id="Process_Client" isExecutable="false">
<bpmn:startEvent id="C_Start" name="Клиент решил перевести деньги"><bpmn:outgoing>F_C1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="C_Enter" name="Ввести телефон получателя, банк и сумму"><bpmn:incoming>F_C1</bpmn:incoming><bpmn:outgoing>F_C2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="C_Submit" name="Нажать «Перевести»"><bpmn:incoming>F_C2</bpmn:incoming><bpmn:outgoing>F_C3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="C_Merge"><bpmn:incoming>F_C3</bpmn:incoming><bpmn:incoming>F_C11</bpmn:incoming><bpmn:incoming>F_C12</bpmn:incoming><bpmn:outgoing>F_C4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="C_EvGw"><bpmn:incoming>F_C4</bpmn:incoming><bpmn:outgoing>F_C5</bpmn:outgoing><bpmn:outgoing>F_C6</bpmn:outgoing><bpmn:outgoing>F_C7</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="C_Warn" name="Пришло предупреждение о риске"><bpmn:incoming>F_C5</bpmn:incoming><bpmn:outgoing>F_C8</bpmn:outgoing><bpmn:messageEventDefinition id="MED_C_Warn" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="C_Call" name="Звонит аналитик банка"><bpmn:incoming>F_C6</bpmn:incoming><bpmn:outgoing>F_C9</bpmn:outgoing><bpmn:messageEventDefinition id="MED_C_Call" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="C_Result" name="Пришёл итог перевода"><bpmn:incoming>F_C7</bpmn:incoming><bpmn:outgoing>F_C10</bpmn:outgoing><bpmn:messageEventDefinition id="MED_C_Result" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="C_Decide" name="Прочитать предупреждение и подтвердить или отменить перевод"><bpmn:incoming>F_C8</bpmn:incoming><bpmn:outgoing>F_C11</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="C_Answer" name="Ответить на вопросы аналитика"><bpmn:incoming>F_C9</bpmn:incoming><bpmn:outgoing>F_C12</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="C_End" name="Клиент знает итог перевода"><bpmn:incoming>F_C10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_C1" sourceRef="C_Start" targetRef="C_Enter" />
<bpmn:sequenceFlow id="F_C2" sourceRef="C_Enter" targetRef="C_Submit" />
<bpmn:sequenceFlow id="F_C3" sourceRef="C_Submit" targetRef="C_Merge" />
<bpmn:sequenceFlow id="F_C4" sourceRef="C_Merge" targetRef="C_EvGw" />
<bpmn:sequenceFlow id="F_C5" sourceRef="C_EvGw" targetRef="C_Warn" />
<bpmn:sequenceFlow id="F_C6" sourceRef="C_EvGw" targetRef="C_Call" />
<bpmn:sequenceFlow id="F_C7" sourceRef="C_EvGw" targetRef="C_Result" />
<bpmn:sequenceFlow id="F_C8" sourceRef="C_Warn" targetRef="C_Decide" />
<bpmn:sequenceFlow id="F_C9" sourceRef="C_Call" targetRef="C_Answer" />
<bpmn:sequenceFlow id="F_C10" sourceRef="C_Result" targetRef="C_End" />
<bpmn:sequenceFlow id="F_C11" name="ждать итог" sourceRef="C_Decide" targetRef="C_Merge" />
<bpmn:sequenceFlow id="F_C12" name="ждать итог" sourceRef="C_Answer" targetRef="C_Merge" />
</bpmn:process>
<bpmn:process id="Process_Bank" isExecutable="false">
<bpmn:laneSet id="LaneSet_Bank">
<bpmn:lane id="Lane_Payment" name="Платёжный сервис СБП">
<bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_Check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_AskAF</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_ApproveMerge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_SendNSPK</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_Complete</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_EndOk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_DeclineMerge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_Decline</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_EndDecl</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_Decision" name="Антифрод: сервис решений (Decision Service)">
<bpmn:flowNodeRef>D_Rules</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_GwRules</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_AskScore</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_Fallback</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_ScoreMerge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_Threshold</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_GwRisk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_Warn</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_WaitAnswer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D_GwConfirm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_Scoring" name="Антифрод: ML-скоринг (ML Scoring Service)">
<bpmn:flowNodeRef>S_Features</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S_Predict</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S_Timeout</bpmn:flowNodeRef>
<bpmn:flowNodeRef>S_Error</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_Analyst" name="Аналитик антифрода (Case Management)">
<bpmn:flowNodeRef>A_Review</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A_Call</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A_Verdict</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A_GwLegit</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_MLPlatform" name="ML-платформа (обучение, реестр моделей)">
<bpmn:flowNodeRef>M_Timer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Dataset</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Train</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Eval</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_GwBetter</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Promote</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_EndNew</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_EndKeep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Complaint</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_Label</bpmn:flowNodeRef>
<bpmn:flowNodeRef>M_EndLabel</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="P_Start" name="Получена заявка на перевод СБП"><bpmn:outgoing>F_P1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_Start" /></bpmn:startEvent>
<bpmn:serviceTask id="P_Check" name="Проверить реквизиты, баланс и лимиты"><bpmn:incoming>F_P1</bpmn:incoming><bpmn:outgoing>F_P2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="P_AskAF" name="Запросить решение антифрода"><bpmn:incoming>F_P2</bpmn:incoming><bpmn:outgoing>F_P3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="P_ApproveMerge"><bpmn:incoming>F_D8</bpmn:incoming><bpmn:incoming>F_D13</bpmn:incoming><bpmn:incoming>F_A4</bpmn:incoming><bpmn:outgoing>F_P4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="P_SendNSPK" name="Отправить перевод в НСПК"><bpmn:incoming>F_P4</bpmn:incoming><bpmn:outgoing>F_P5</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="P_Complete" name="Провести списание и уведомить клиента"><bpmn:incoming>F_P5</bpmn:incoming><bpmn:outgoing>F_P6</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Ok"><bpmn:targetRef>M_DWH</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="P_EndOk" name="Перевод выполнен"><bpmn:incoming>F_P6</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="P_DeclineMerge"><bpmn:incoming>F_D2</bpmn:incoming><bpmn:incoming>F_D14</bpmn:incoming><bpmn:incoming>F_A5</bpmn:incoming><bpmn:outgoing>F_P7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="P_Decline" name="Отменить перевод и уведомить клиента"><bpmn:incoming>F_P7</bpmn:incoming><bpmn:outgoing>F_P8</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Decl"><bpmn:targetRef>M_DWH</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="P_EndDecl" name="Перевод отклонён"><bpmn:incoming>F_P8</bpmn:incoming></bpmn:endEvent>
<bpmn:businessRuleTask id="D_Rules" name="Проверить стоп-листы и жёсткие правила"><bpmn:incoming>F_P3</bpmn:incoming><bpmn:outgoing>F_D1</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="D_GwRules" name="Сработало жёсткое правило?"><bpmn:incoming>F_D1</bpmn:incoming><bpmn:outgoing>F_D2</bpmn:outgoing><bpmn:outgoing>F_D3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="D_AskScore" name="Запросить скор модели"><bpmn:incoming>F_D3</bpmn:incoming><bpmn:outgoing>F_D4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="D_Fallback" name="Посчитать резервный риск по правилам"><bpmn:incoming>F_S3</bpmn:incoming><bpmn:incoming>F_S4</bpmn:incoming><bpmn:outgoing>F_D5</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="D_ScoreMerge"><bpmn:incoming>F_S2</bpmn:incoming><bpmn:incoming>F_D5</bpmn:incoming><bpmn:outgoing>F_D6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="D_Threshold" name="Определить уровень риска по порогам"><bpmn:incoming>F_D6</bpmn:incoming><bpmn:outgoing>F_D7</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Score"><bpmn:targetRef>M_DWH</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="D_GwRisk" name="Уровень риска?"><bpmn:incoming>F_D7</bpmn:incoming><bpmn:outgoing>F_D8</bpmn:outgoing><bpmn:outgoing>F_D9</bpmn:outgoing><bpmn:outgoing>F_D10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="D_Warn" name="Показать клиенту предупреждение о риске"><bpmn:incoming>F_D9</bpmn:incoming><bpmn:outgoing>F_D11</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="D_WaitAnswer" name="Получен ответ клиента"><bpmn:incoming>F_D11</bpmn:incoming><bpmn:outgoing>F_D12</bpmn:outgoing><bpmn:messageEventDefinition id="MED_D_WaitAnswer" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="D_GwConfirm" name="Клиент подтвердил перевод?"><bpmn:incoming>F_D12</bpmn:incoming><bpmn:outgoing>F_D13</bpmn:outgoing><bpmn:outgoing>F_D14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:dataStoreReference id="S_FeatStore" name="Онлайн-хранилище признаков" />
<bpmn:serviceTask id="S_Features" name="Собрать признаки перевода"><bpmn:incoming>F_D4</bpmn:incoming><bpmn:outgoing>F_S1</bpmn:outgoing><bpmn:property id="Property_S_Features" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DA_Feat"><bpmn:sourceRef>S_FeatStore</bpmn:sourceRef><bpmn:targetRef>Property_S_Features</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="S_Predict" name="Рассчитать вероятность мошенничества моделью"><bpmn:incoming>F_S1</bpmn:incoming><bpmn:outgoing>F_S2</bpmn:outgoing><bpmn:property id="Property_S_Predict" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DA_Reg"><bpmn:sourceRef>M_Registry</bpmn:sourceRef><bpmn:targetRef>Property_S_Predict</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:boundaryEvent id="S_Timeout" name="Нет ответа за 150 мс" attachedToRef="S_Predict" cancelActivity="true"><bpmn:outgoing>F_S3</bpmn:outgoing><bpmn:timerEventDefinition id="TED_S_Timeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.15S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="S_Error" name="Модель недоступна" attachedToRef="S_Predict" cancelActivity="true"><bpmn:outgoing>F_S4</bpmn:outgoing><bpmn:errorEventDefinition id="EED_S_Error" errorRef="Error_ModelUnavailable" /></bpmn:boundaryEvent>
<bpmn:userTask id="A_Review" name="Изучить кейс и причины скора"><bpmn:incoming>F_D10</bpmn:incoming><bpmn:outgoing>F_A1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="A_Call" name="Позвонить клиенту и уточнить перевод"><bpmn:incoming>F_A1</bpmn:incoming><bpmn:outgoing>F_A2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="A_Verdict" name="Зафиксировать вердикт по кейсу"><bpmn:incoming>F_A2</bpmn:incoming><bpmn:outgoing>F_A3</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Verdict"><bpmn:targetRef>M_DWH</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="A_GwLegit" name="Перевод легитимный?"><bpmn:incoming>F_A3</bpmn:incoming><bpmn:outgoing>F_A4</bpmn:outgoing><bpmn:outgoing>F_A5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:dataStoreReference id="M_Registry" name="Реестр моделей (MLflow)" />
<bpmn:dataStoreReference id="M_DWH" name="Журнал решений и меток (DWH)" />
<bpmn:startEvent id="M_Timer" name="Еженедельно, вс 03:00"><bpmn:outgoing>F_M1</bpmn:outgoing><bpmn:timerEventDefinition id="TED_M_Timer"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 3 ? * SUN</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="M_Dataset" name="Собрать обучающую выборку с метками"><bpmn:incoming>F_M1</bpmn:incoming><bpmn:outgoing>F_M2</bpmn:outgoing><bpmn:property id="Property_M_Dataset" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DA_Train"><bpmn:sourceRef>M_DWH</bpmn:sourceRef><bpmn:targetRef>Property_M_Dataset</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="M_Train" name="Обучить модель-претендента"><bpmn:incoming>F_M2</bpmn:incoming><bpmn:outgoing>F_M3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="M_Eval" name="Сравнить претендента с текущей моделью"><bpmn:incoming>F_M3</bpmn:incoming><bpmn:outgoing>F_M4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="M_GwBetter" name="Претендент лучше?"><bpmn:incoming>F_M4</bpmn:incoming><bpmn:outgoing>F_M5</bpmn:outgoing><bpmn:outgoing>F_M6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="M_Promote" name="Опубликовать модель как champion"><bpmn:incoming>F_M5</bpmn:incoming><bpmn:outgoing>F_M7</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Promote"><bpmn:targetRef>M_Registry</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="M_EndNew" name="Новая версия модели в проде"><bpmn:incoming>F_M7</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="M_EndKeep" name="Оставлена текущая версия"><bpmn:incoming>F_M6</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="M_Complaint" name="Жалоба клиента о мошенничестве"><bpmn:outgoing>F_M8</bpmn:outgoing><bpmn:messageEventDefinition id="MED_M_Complaint" /></bpmn:startEvent>
<bpmn:serviceTask id="M_Label" name="Записать метку «мошенничество» по жалобе"><bpmn:incoming>F_M8</bpmn:incoming><bpmn:outgoing>F_M9</bpmn:outgoing><bpmn:dataOutputAssociation id="DA_Label"><bpmn:targetRef>M_DWH</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="M_EndLabel" name="Метка добавлена"><bpmn:incoming>F_M9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_P1" sourceRef="P_Start" targetRef="P_Check" />
<bpmn:sequenceFlow id="F_P2" sourceRef="P_Check" targetRef="P_AskAF" />
<bpmn:sequenceFlow id="F_P3" sourceRef="P_AskAF" targetRef="D_Rules" />
<bpmn:sequenceFlow id="F_D1" sourceRef="D_Rules" targetRef="D_GwRules" />
<bpmn:sequenceFlow id="F_D2" name="Да: отказ по правилу" sourceRef="D_GwRules" targetRef="P_DeclineMerge" />
<bpmn:sequenceFlow id="F_D3" name="Нет" sourceRef="D_GwRules" targetRef="D_AskScore" />
<bpmn:sequenceFlow id="F_D4" sourceRef="D_AskScore" targetRef="S_Features" />
<bpmn:sequenceFlow id="F_S1" sourceRef="S_Features" targetRef="S_Predict" />
<bpmn:sequenceFlow id="F_S2" name="скор p" sourceRef="S_Predict" targetRef="D_ScoreMerge" />
<bpmn:sequenceFlow id="F_S3" sourceRef="S_Timeout" targetRef="D_Fallback" />
<bpmn:sequenceFlow id="F_S4" sourceRef="S_Error" targetRef="D_Fallback" />
<bpmn:sequenceFlow id="F_D5" name="резервный скор" sourceRef="D_Fallback" targetRef="D_ScoreMerge" />
<bpmn:sequenceFlow id="F_D6" sourceRef="D_ScoreMerge" targetRef="D_Threshold" />
<bpmn:sequenceFlow id="F_D7" sourceRef="D_Threshold" targetRef="D_GwRisk" />
<bpmn:sequenceFlow id="F_D8" name="Низкий: p &lt; 0,30" sourceRef="D_GwRisk" targetRef="P_ApproveMerge" />
<bpmn:sequenceFlow id="F_D9" name="Средний: 0,30–0,85" sourceRef="D_GwRisk" targetRef="D_Warn" />
<bpmn:sequenceFlow id="F_D10" name="Высокий: p ≥ 0,85, перевод приостановлен" sourceRef="D_GwRisk" targetRef="A_Review" />
<bpmn:sequenceFlow id="F_D11" sourceRef="D_Warn" targetRef="D_WaitAnswer" />
<bpmn:sequenceFlow id="F_D12" sourceRef="D_WaitAnswer" targetRef="D_GwConfirm" />
<bpmn:sequenceFlow id="F_D13" name="Да" sourceRef="D_GwConfirm" targetRef="P_ApproveMerge" />
<bpmn:sequenceFlow id="F_D14" name="Нет" sourceRef="D_GwConfirm" targetRef="P_DeclineMerge" />
<bpmn:sequenceFlow id="F_A1" sourceRef="A_Review" targetRef="A_Call" />
