@startuml 01-context
!include <C4/C4_Context>

title C4 · Уровень 1 · System Context — антифрод-решение по исходящему переводу СБП (Т-Банк)

Person(client, "Клиент-отправитель", "Переводит деньги по номеру телефона через СБП")
Person(analyst, "Аналитик антифрода", "Разбирает приостановленные переводы с высоким риском")

System(antifraud, "Антифрод-система СБП-переводов", "Решает по каждому исходящему переводу: пропустить, запросить подтверждение у клиента, приостановить до проверки аналитиком или отклонить. Внутри работает ML-модель риска мошенничества")

System_Ext(app, "Мобильное приложение Т-Банка", "Форма перевода, push-уведомления и экран предупреждения о риске")
System_Ext(payments, "Платёжный сервис СБП", "Принимает заявку на перевод, проверяет баланс и лимиты, проводит списание")
System_Ext(nspk, "НСПК (операционный центр СБП)", "Межбанковская маршрутизация перевода в банк получателя")
System_Ext(fincert, "База ФинЦЕРТ Банка России", "Сведения о случаях и попытках переводов без согласия клиента")
System_Ext(support, "Служба поддержки (CRM)", "Принимает жалобы клиентов на мошенничество")

Rel(client, app, "Вводит реквизиты, подтверждает или отменяет перевод")
Rel(app, payments, "Заявка на перевод")
Rel(payments, antifraud, "Запрос решения по переводу", "gRPC, синхронно")
Rel(antifraud, payments, "Решение: пропустить / отклонить")
Rel(antifraud, app, "Предупреждение о риске и запрос подтверждения", "push")
Rel(app, antifraud, "Ответ клиента: подтвердил / отменил")
Rel(analyst, antifraud, "Вердикт по кейсу после звонка клиенту", "веб-интерфейс")
Rel(analyst, client, "Звонит и уточняет детали перевода", "телефон")
Rel(payments, nspk, "Платёж и подтверждение", "API СБП")
Rel(fincert, antifraud, "Реестр получателей-дропов", "ежедневная выгрузка")
Rel(support, antifraud, "Жалоба «перевод был мошенническим»", "событие")

SHOW_LEGEND()
@enduml
